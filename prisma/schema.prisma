generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             String         @id @default(cuid())
  email          String?        @unique
  username       String?        @unique
  password       String?
  name           String?
  accounts       Account[]
  journalEntries JournalEntry[]
  strategies     Strategy[]
  mistakes       Mistake[]
  tags           Tag[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Account {
  id             String            @id @default(cuid())
  name           String
  description    String?
  currency       String            @default("USD")
  initialBalance Float
  currentBalance Float
  profitTarget   Float?
  maxDrawdown    Float?
  dailyLossLimit Float?
  accountType    String?           @default("LIVE")
  status         String            @default("HEALTHY")
  isArchived     Boolean           @default(false)
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  trades         Trade[]
  snapshots      AccountSnapshot[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Trade {
  id              String       @id @default(cuid())
  date            DateTime     @default(now())
  symbol          String
  direction       String
  entryPrice      Float
  exitPrice       Float?
  stopLoss        Float?
  takeProfit      Float?
  lotSize         Float
  riskAmount      Float?
  riskPercent     Float?
  rewardToRisk    Float?
  actualR         Float?
  pnl             Float?
  pnlPercentage   Float?
  result          String?
  status          String       @default("CLOSED")
  strategyId      String?
  strategy        Strategy?    @relation(fields: [strategyId], references: [id])
  session         String?
  timeframe       String?
  marketCondition String?
  notes           String?
  preTradePlan    String?
  postTradeReview String?
  emotion         String?
  accountId       String
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  images          TradeImage[]
  audioUrl        String?
  audioId         String?
  tags            TradeTag[]
  mistakes        Mistake[]    @relation("TradeMistakes")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model TradeImage {
  id        String   @id @default(cuid())
  url       String
  type      String?
  tradeId   String
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Strategy {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  trades      Trade[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id     String     @id @default(cuid())
  name   String
  userId String
  user   User       @relation(fields: [userId], references: [id])
  trades TradeTag[]

  @@unique([name, userId])
}

model TradeTag {
  tradeId String
  tagId   String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tradeId, tagId])
}

model Mistake {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  trades      Trade[]  @relation("TradeMistakes")

  @@unique([name, userId])
}

model AccountSnapshot {
  id        String   @id @default(cuid())
  balance   Float
  pnl       Float
  date      DateTime @default(now())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  marketBias    String?
  importantNews String?
  plan          String?
  levels        String?
  scenarios     String?
  lessons       String?
  mistakes      String?
  tomorrowPlan  String?
  mood          String?
  rating        Int?
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, date])
}
